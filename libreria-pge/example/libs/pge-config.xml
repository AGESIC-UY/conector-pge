<PGEConfig xmlns="urn:agesic:pge:config:1.0" >
	<STSConfig url="https://testservicios.pge.red.uy:6051/TrustServer/SecurityTokenServiceProtected">
		<Property Key="SSLContextInitializer" Value="uy.gub.agesic.pge.core.ssl.SSLContextInitializerCXF"/>
		<Property Key="Role" Value="ou=test,o=agesic"/>
	    <Property Key="Policy" Value="urn:tokensimple"/>
		<Property Key="Issuer" Value="Agesic"/>
		<Property Key="Username" Value="prueba"/>
		<!-- Timeout de la invocacion al STS en milisegudos-->
		<Property Key="STSTimeOut" Value="5000"/>
		<!-- Timeout del token SAML que se envia al STS en milisegundos -->
		<Property Key="TokenTimeOut" Value="950000"/>

		<Property Key="WsaTo" Value="http://testservicios.pge.red.uy/timestamp"/>
		<!-- SAML version "1.1" | "1.2" -->
        <Property Key="SAMLVersion" Value="1.1"/>
        <!-- SOAP version "1.1" | "1.2" | "multiple" -->
        <Property Key="SOAPVersion" Value="1.1"/>
        <!-- It is cache token enabled "0": Disabled | "1": Enabled -->
        <Property Key="CacheTokenEnabled" Value="0"/>
	</STSConfig>
	<KeyStore>
		<!-- 
			Los path soportan tanto la ruta absoluta o el formato URL
			Ej.
				file:///path_to_keystore
				jar:///path_to_keystore
			o un resource
			Ej.
				uy/gub/agesic/keystore.jks
		 -->
		<!-- Ruta a la keystore del Organismo  -->
		<Auth Key="KeyStoreURL" Value="conector.keystore"/>
		<!-- 
			Password encritada (ver: https://community.jboss.org/wiki/PicketLinkConfigurationMaskPassword) 
			de la keystore, puede ser en texto plano tambien  
		-->
		<Auth Key="KeyStorePass" Value="ConectorPGE2019"/>
		<!-- Alias del certificado del organismo en la keystore -->
		<Auth Key="KeyStoreAlias" Value="conector.pge.red.uy"/>

		<!-- Alias del certificado del SSL en la keystore -->
		<Auth Key="KeyStoreAliasSSL" Value="conector.pge.red.uy"/>

		<!-- Keystore para la conexion SSL -->
  		<Auth Key="SSLKeyStoreURL" Value="conector.keystore"/>
  		<!-- 
			Password encritada (ver: https://community.jboss.org/wiki/PicketLinkConfigurationMaskPassword) 
			de la keystore, puede ser en texto plano tambien  
		-->
  		<Auth Key="SSLKeyStorePass" Value="ConectorPGE2019"/>
  		<!-- truststore para los certificados de confianza -->
		<Auth Key="TrustStoreURL" Value="conector.truststore"/>
		<!-- 
			Password encritada (ver: https://community.jboss.org/wiki/PicketLinkConfigurationMaskPassword) 
			de la keystore, puede ser en texto plano tambien  
		-->
  		<Auth Key="TrustStorePass" Value="ConectorPGE2019"/>
  		<!-- 
  			Valores utilizados para la encriptacion de las claves, debe ser el mismo para todas
  			las claves. 
  		 -->
  		<Auth Key="salt" Value="saltword"/>
        <Auth Key="iterationCount" Value="117"/>
  	</KeyStore>
  	<SAMLConfig>
		<!--PGE Client Config-->
  	    <Property Key="SAML1NameIDFormat" Value="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" />
  	    <Property Key="SAML1ConfirmationMethod" Value="urn:oasis:names:tc:SAML:1.0:cm:bearer" />
  	    <Property Key="SAML1AuthenticationMethod" Value="urn:oasis:names:tc:SAML:1.0:am:password" />

  	    <Property Key="SAML2NameIDFormat" Value="urn:oasis:names:tc:SAML:2.0:nameid-format:entity" />
  	    <Property Key="SAML2ConfirmationMethod" Value="urn:oasis:names:tc:SAML:2.0:cm:bearer" />
  	    <Property Key="SAML2AuthnContext" Value="urn:oasis:names:tc:SAML:2.0:ac:classes:X509" />

  	    <Property Key="SignatureAlgorithm" Value="http://www.w3.org/2000/09/xmldsig#rsa-sha1" />
  	    <Property Key="SignatureCanonicalizationAlgorithm" Value="http://www.w3.org/2001/10/xml-exc-c14n#" />

		<!--Connector Config-->
  	    <Property Key="MaxTotalOpenConnections" Value="200" />
  	    <Property Key="MaxConnectionsPerRoute" Value="10" />
  	    <Property Key="MaxConnectionsHostnamePort" Value="50" />
  	</SAMLConfig>
</PGEConfig>